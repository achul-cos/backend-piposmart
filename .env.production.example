APP_NAME=crm-piposmart-backend
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8080
APP_BASE_PATH=/api/v1
APP_TIMEZONE=UTC
APP_SHUTDOWN_TIMEOUT=10s

HTTP_READ_TIMEOUT=15s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s

LOG_LEVEL=info
LOG_FORMAT=json

DB_HOST=mysql
DB_PORT=3306
DB_NAME=crm_piposmart
DB_USER=crm_user
DB_PASSWORD=replace-with-strong-db-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
DB_CHARSET=utf8mb4
DB_PARSE_TIME=true
DB_LOCATION=UTC
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONNECT_TIMEOUT=10s

CORS_ALLOWED_ORIGINS=https://crm.example.com
CORS_ALLOW_CREDENTIALS=true

UPLOAD_DIR=./storage/uploads
EXPORT_DIR=./storage/exports
MAX_UPLOAD_SIZE_MB=20

WORKER_POLL_INTERVAL=3s
WORKER_MAX_ATTEMPTS=5
WORKER_STALE_JOB_TIMEOUT=15m

MIGRATION_DIR=./migrations

JWT_ISSUER=crm-piposmart
JWT_ACCESS_SECRET=replace-with-minimum-32-byte-secret
JWT_ACCESS_TTL=120m
JWT_REFRESH_TTL=168h
AUTH_COOKIE_NAME=piposmart_refresh
AUTH_COOKIE_DOMAIN=crm.example.com
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax

BOOTSTRAP_ADMIN_NAME=Initial Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PHONE=6281200000000
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-admin-password

SETUP_RUN_MIGRATE=true
SETUP_RUN_SEED_MASTER=true
SETUP_RUN_BOOTSTRAP_ADMIN=true
SETUP_RUN_DEMO_SEED=false
SETUP_DEMO_PRESET=minimal
SETUP_DEMO_SEED=20260723
SETUP_DEMO_FROM=2026-07-28
SETUP_DEMO_TO=2026-07-28
SETUP_DEMO_SCALE=1
SETUP_DEMO_VARIATION=0.5

DATA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
